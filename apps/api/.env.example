# Copiá este archivo a apps/api/.env y completá los valores.
# Las variables que ya estén definidas en el entorno tienen prioridad sobre este archivo.
# Una variable vacía cuenta como no definida (se usa el valor por defecto, si tiene).

# --- Servidor ---

# development | test | production. En development los logs salen con colores (pino-pretty).
NODE_ENV=development
# Interfaz donde escucha la API. 0.0.0.0 para aceptar conexiones de afuera (Docker, Render, etc.).
HOST=0.0.0.0
# Puerto HTTP (1-65535).
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Cantidad de proxies delante de la API (load balancer de Render/Railway/Fly = 1).
# Con 0 se ignora X-Forwarded-For y se usa la IP de la conexión.
TRUST_PROXY=0
# Orígenes de la web que pueden llamar a la API, separados por coma.
# Origen exacto: protocolo + dominio + puerto, sin barra final ni ruta.
CORS_ORIGINS=http://localhost:5173
# Milisegundos que espera el apagado ordenado a que terminen los requests en curso.
SHUTDOWN_TIMEOUT_MS=10000

# --- Supabase ---
# Dashboard de Supabase → Project Settings → API (o la salida de `supabase status` en local).

# Project URL, ej.: https://abcdefghijklmnop.supabase.co (en local: http://127.0.0.1:54321).
SUPABASE_URL=
# Secret key (sb_secret_...) o, en proyectos viejos, la service_role key (JWT).
# Dashboard → Project Settings → API Keys. Saltea RLS: nunca la expongas fuera del servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Solo para proyectos con JWT legacy firmados con HS256:
# Dashboard → Project Settings → JWT Keys → Legacy JWT Secret. Dejalo vacío si usás claves asimétricas.
SUPABASE_JWT_SECRET=
# Bucket privado donde el scraper sube las fotos de los perfiles.
STORAGE_MEDIA_BUCKET=profile-media

# --- Claude (Anthropic) ---

# API key de https://platform.claude.com → Settings → API keys. Empieza con sk-ant-.
ANTHROPIC_API_KEY=
# Modelo para el análisis de perfiles y los mensajes de apertura.
CLAUDE_MODEL=claude-opus-5-5
# Esfuerzo del modelo: low | medium | high | xhigh | max. Más esfuerzo = mejor análisis, más costo.
CLAUDE_EFFORT=medium
