{
  "name": "@rrpp/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de RRPP Suite: única puerta a la base de datos.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
